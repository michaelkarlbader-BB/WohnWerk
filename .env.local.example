# Supabase (Optional - remove if not using backend)
#
# IMPORTANT: put your TEST environment keys here, never your live keys.
# This file feeds local `npm run dev` — it must never touch real user data.
# Which keys go here depends on the Environment strategy chosen in /init
# (see docs/PRD.md → Constraints):
#   - local         → your LOCAL Supabase instance (from `supabase start`),
#                     e.g. URL http://127.0.0.1:54321 and the local anon key
#                     it prints. Production is migrated at /deploy.
#   - two-projects  → your "dev" project's keys (the "prod" project's keys
#                     are added in the host's panel at /deploy, never here)
#   - single        → your one project's keys (test == live; be careful)
#   - branching     → your persistent "staging" branch keys (production is
#                     promoted via Merge at /deploy)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase CLI (migrations, `supabase db push`): needs nothing in this file.
# Run `supabase login` and `supabase link --project-ref <ref>` once — the CLI keeps
# the token and the database password in your system's credential store. Never put
# the database password here, and never behind a NEXT_PUBLIC_ prefix.

# PROJ-1 Benutzerkonto & Login
# Adresse, unter der diese Umgebung erreichbar ist (ohne Schrägstrich am Ende) –
# Links in Bestätigungs- und Passwort-Mails führen dorthin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile (CAPTCHA): Site Key des Widgets – Cloudflare Dashboard → Turnstile.
# Der Secret Key gehört NICHT hierher, sondern ins Supabase-Dashboard
# (Authentication → Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# Brevo (App-eigene Mails): API-Schlüssel – brevo.com → SMTP & API → API Keys.
# Nur serverseitig, nie mit NEXT_PUBLIC_.
BREVO_API_KEY=your_brevo_api_key_here
# Bei Brevo verifizierte Absenderadresse (Senders).
MAIL_FROM_ADDRESS=noreply@example.com
# Server-Schlüssel des Fehlversuchszählers (Sperre nach 5 Fehlversuchen). Nur serverseitig,
# nie mit NEXT_PUBLIC_. Mindestens 32 Zeichen, zufällig, z. B. `openssl rand -hex 32`.
# Derselbe Wert steht im Supabase-Projekt in Vault unter dem Namen `login_sperre_schluessel`
# (SQL Editor: select vault.create_secret('<wert>', 'login_sperre_schluessel');).
LOGIN_SPERRE_SCHLUESSEL=your_login_lock_key_here_at_least_32_chars

# Add more environment variables as needed
# STRIPE_SECRET_KEY=sk_...
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
